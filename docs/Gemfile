# Local preview only. GitHub Pages builds this site server-side and ignores
# this Gemfile. To preview locally:
#   cd docs && bundle install && bundle exec jekyll serve
source "https://rubygems.org"

# Mirrors the GitHub Pages build environment.
gem "github-pages", group: :jekyll_plugins

# Plugins used by _config.yml
group :jekyll_plugins do
  gem "jekyll-remote-theme"
  gem "jekyll-seo-tag"
end

# Windows / JRuby tzinfo (harmless elsewhere)
platforms :mingw, :x64_mingw, :mswin, :jruby do
  gem "tzinfo", ">= 1", "< 3"
  gem "tzinfo-data"
end

gem "wdm", "~> 0.1.1", :platforms => [:mingw, :x64_mingw, :mswin]
